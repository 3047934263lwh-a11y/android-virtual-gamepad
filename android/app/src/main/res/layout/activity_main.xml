<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <com.vgamepad.GamepadView
        android:id="@+id/gamepadView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 展开连接栏时铺在手柄之上：内容为手柄画面的模糊快照，形成 visionOS 的玻璃底 -->
    <ImageView
        android:id="@+id/blurOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/connBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/bg_glass_bar"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:gravity="center_vertical"
        android:minHeight="46dp"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:visibility="invisible">

        <!-- 原位置「手柄」文字 + 连接状态点：连接栏唯一的折叠开关，始终可见 -->
        <!-- 文字与圆点作为一个整体居中：左右 padding 对称（12dp/12dp），
             [文字 + 5dp 间距 + 8dp 圆点] 组合的重心严格落在胶囊几何中心，
             左右留白均匀，统一中心轴线对齐 -->
        <LinearLayout
            android:id="@+id/titleBox"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_chip_state"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@string/bar_title"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="6dp"
            android:paddingEnd="12dp"
            android:paddingBottom="6dp">

            <TextView
                android:id="@+id/barTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.10"
                android:maxLines="1"
                android:singleLine="true"
                android:text="@string/bar_title"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:id="@+id/statusDot"
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginStart="5dp"
                android:importantForAccessibility="no"
                android:background="@drawable/bg_dot_state" />

        </LinearLayout>

        <EditText
            android:id="@+id/ipInput"
            android:layout_width="140dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_glass_field"
            android:hint="@string/hint_ip"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/portInput"
            android:layout_width="60dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_field"
            android:hint="@string/hint_port"
            android:imeOptions="actionDone"
            android:inputType="number"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_secondary"
            android:textSize="13sp" />

        <!-- 连接开关：双色滑块（左=开色 / 右=关色），点击即左右切换 -->
        <com.vgamepad.SlideSwitch
            android:id="@+id/connectSwitch"
            android:layout_width="76dp"
            android:layout_height="26dp"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/connect_switch_desc" />

        <ImageButton
            android:id="@+id/settingsBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_icon"
            android:contentDescription="@string/settings_desc"
            android:src="@drawable/ic_settings" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:background="@drawable/bg_pill"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="10dp"
            android:paddingBottom="5dp"
            android:text="@string/status_idle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/editBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingTop="8dp"
        android:paddingEnd="10dp"
        android:paddingBottom="8dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/editLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/edit_pick"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <SeekBar
            android:id="@+id/editSeek"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:contentDescription="@string/edit_seek_desc"
            android:max="450"
            android:progress="50" />

        <com.vgamepad.GlassButton
            android:id="@+id/editResetOne"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/edit_reset_one"
            android:textSize="12sp" />

        <com.vgamepad.GlassButton
            android:id="@+id/editResetAll"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="@string/edit_reset_all"
            android:textSize="12sp" />

        <com.vgamepad.GlassButton
            android:id="@+id/editDone"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:layout_marginStart="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/edit_done"
            android:textSize="12sp" />

    </LinearLayout>

</FrameLayout>
